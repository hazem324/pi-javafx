<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<BorderPane fx:id="bp"
            prefHeight="600.0"
            prefWidth="800.0"
            stylesheets="@/assets/style/home.css"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.home.homeController">

    <!-- Topbar -->
    <top>
        <HBox styleClass="topbar" alignment="CENTER" spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Welcome to CultureSpace" styleClass="topbar-text"/>
        </HBox>
    </top>

    <!-- Navbar -->
    <center>
        <VBox styleClass="main-container" spacing="20">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <HBox styleClass="navbar" alignment="CENTER" spacing="15">
                <Button text="Home" styleClass="nav-button"/>
                <Button text="About" styleClass="nav-button"/>
                <Button text="Events" styleClass="nav-button"/>
                <Button text="Blog" styleClass="nav-button"/>
                <Button text="Contact" styleClass="nav-button"/>
            </HBox>

            <!-- About Section -->
            <VBox styleClass="about-section" spacing="10" alignment="CENTER">
                <Text text="About CultureSpace" styleClass="section-title"/>
                <Label text="CultureSpace is your gateway to cultural events across Tunisia, Algeria, Morocco, and Mauritania." styleClass="section-text"/>
            </VBox>

            <!-- Calendar Section -->
            <VBox styleClass="calendar-section" spacing="15" alignment="CENTER">
                <Text text="Calendrier des Événements Culturels" styleClass="section-title"/>
                <Label text="Découvrez les événements culturels en Tunisie, Algérie, Maroc et Mauritanie." styleClass="section-text"/>
                <TableView fx:id="calendarTable" prefHeight="300" prefWidth="600" styleClass="calendar-table">
                    <columns>
                        <TableColumn fx:id="colTitle" text="Événement" prefWidth="200"/>
                        <TableColumn fx:id="colStart" text="Début" prefWidth="100"/>
                        <TableColumn fx:id="colEnd" text="Fin" prefWidth="100"/>
                        <TableColumn fx:id="colDescription" text="Description" prefWidth="200"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Blog Section -->
            <VBox styleClass="blog-section" spacing="10" alignment="CENTER">
                <Text text="Latest Blog Posts" styleClass="section-title"/>
                <Label text="Stay updated with our latest cultural insights and stories." styleClass="section-text"/>
                <HBox spacing="20" alignment="CENTER">
                    <VBox styleClass="blog-post" spacing="5">
                        <Label text="Blog Post 1" styleClass="blog-title"/>
                        <Label text="Discover the vibrant festivals of Tunisia." styleClass="blog-text"/>
                    </VBox>
                    <VBox styleClass="blog-post" spacing="5">
                        <Label text="Blog Post 2" styleClass="blog-title"/>
                        <Label text="Explore the rich heritage of Morocco." styleClass="blog-text"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox styleClass="footer" alignment="CENTER" spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="© 2025 CultureSpace. All rights reserved." styleClass="footer-text"/>
        </HBox>
    </bottom>
</BorderPane>